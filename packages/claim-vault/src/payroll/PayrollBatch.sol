pragma solidity 0.8.23;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/security/ReentrancyGuard.sol";

import {ISignatureTransfer} from "../interfaces/ISignatureTransfer.sol";
import {IPeanutV4MFAVault} from "../interfaces/IPeanutV4MFAVault.sol";

/// @title PayrollBatch — one payroll, one transaction, exactly what the quorum signed.
/// @notice A workspace treasury is a weighted-multisig MSCA whose ColdStorage AddressBook
///         rejects any userOp that is not a plain ERC-20 transfer to an allowlisted
///         address, so the treasury cannot call this contract. Instead it approves the
///         canonical Permit2 once per token, and for each payroll the quorum signs a Permit2
///         batch WITNESS permit (validated through ERC-1271 against the treasury) whose
///         witness commits to the exact payout list. This contract then, atomically:
///           1. pulls exactly the permitted amount of each token from the treasury,
///           2. pays every recipient that has a wallet,
///           3. deposits each walletless recipient's share into the claim vault as an MFA
///              bearer link, refundable to the treasury after CLAIM_WINDOW.
///         Any token (6/8/18 decimals, non-3009, no-return ERC-20s). All-or-nothing. No
///         owner, no fees, no sweep, not upgradeable, and no BUFI key ever holds the funds.
contract PayrollBatch is ReentrancyGuard {
    using SafeERC20 for IERC20;

    struct Payout {
        address token;
        address recipient;
        uint256 amount;
    }

    struct ClaimDeposit {
        address token;
        /// Address of the claim link's key (generated by the treasurer's browser).
        address linkPubKey20;
        uint256 amount;
    }

    /// Permit2 witness. `payrollHash` = `payrollHash(payrollId, payouts, claims)`.
    string public constant WITNESS_TYPE_STRING =
        "PayrollWitness witness)PayrollWitness(bytes32 payrollId,bytes32 payrollHash)TokenPermissions(address token,uint256 amount)";
    bytes32 public constant PAYROLL_WITNESS_TYPEHASH =
        keccak256("PayrollWitness(bytes32 payrollId,bytes32 payrollHash)");

    /// Unclaimed links become refundable to the treasury after this (founder: 30 days).
    uint40 public constant CLAIM_WINDOW = 30 days;
    /// Bounds the loops (gas) — mirrors the app's 50-recipient payroll cap with headroom.
    uint256 public constant MAX_LINES = 100;

    ISignatureTransfer public immutable PERMIT2;
    IPeanutV4MFAVault public immutable VAULT;

    /// Second replay lock beside the Permit2 nonce: one execution per (treasury, payrollId).
    mapping(address => mapping(bytes32 => bool)) public payrollExecuted;

    event PayrollExecuted(
        bytes32 indexed payrollId, address indexed from, uint256 payoutCount, uint256 claimCount
    );
    event PayrollPayout(
        bytes32 indexed payrollId, address indexed token, address indexed recipient, uint256 amount
    );
    event PayrollClaimDeposited(
        bytes32 indexed payrollId,
        address indexed token,
        address indexed linkPubKey20,
        uint256 amount,
        uint256 depositIndex,
        uint40 reclaimableAfter
    );

    error EmptyPayroll();
    error TooManyLines();
    error AlreadyExecuted();
    error UnknownToken(address token);
    error DuplicateToken(address token);
    error PermittedAmountMismatch(address token, uint256 permitted, uint256 owed);
    error ShortReceipt(address token, uint256 expected, uint256 received);
    error Retained(address token);
    error BadRecipient(address recipient);
    error ZeroLinkKey();
    error ZeroAmount();

    constructor(ISignatureTransfer permit2, IPeanutV4MFAVault vault) {
        require(address(permit2) != address(0) && address(vault) != address(0), "ZERO ADDRESS");
        PERMIT2 = permit2;
        VAULT = vault;
    }

    /// The commitment the quorum signs (inside the Permit2 witness). Bound to this chain and
    /// this contract so a signature cannot be replayed on another deployment.
    function payrollHash(
        bytes32 payrollId,
        Payout[] calldata payouts,
        ClaimDeposit[] calldata claims
    ) public view returns (bytes32) {
        return keccak256(abi.encode(block.chainid, address(this), payrollId, payouts, claims));
    }

    /// The Permit2 witness value for a payroll.
    function witnessOf(
        bytes32 payrollId,
        Payout[] calldata payouts,
        ClaimDeposit[] calldata claims
    ) public view returns (bytes32) {
        return keccak256(
            abi.encode(PAYROLL_WITNESS_TYPEHASH, payrollId, payrollHash(payrollId, payouts, claims))
        );
    }

    function executePayroll(
        ISignatureTransfer.PermitBatchTransferFrom calldata permit,
        address from,
        bytes calldata signature,
        bytes32 payrollId,
        Payout[] calldata payouts,
        ClaimDeposit[] calldata claims
    ) external nonReentrant {
        uint256 lines = payouts.length + claims.length;
        if (lines == 0) revert EmptyPayroll();
        if (lines > MAX_LINES) revert TooManyLines();
        if (payrollExecuted[from][payrollId]) revert AlreadyExecuted();
        payrollExecuted[from][payrollId] = true;

        uint256[] memory owed = _owedPerToken(permit, payouts, claims);
        uint256[] memory before =
            _pull(permit, from, signature, witnessOf(payrollId, payouts, claims), owed);
        _payAll(payrollId, payouts);
        _depositClaims(payrollId, from, claims);
        _assertNoRetention(permit, before);

        emit PayrollExecuted(payrollId, from, payouts.length, claims.length);
    }

    /// Pulls exactly `owed` of each permitted token from `from` through Permit2, measuring
    /// balance deltas so a fee-on-transfer or short-paying token reverts instead of leaving
    /// the batch insolvent. Returns the pre-pull balances for the retention check.
    function _pull(
        ISignatureTransfer.PermitBatchTransferFrom calldata permit,
        address from,
        bytes calldata signature,
        bytes32 witness,
        uint256[] memory owed
    ) internal returns (uint256[] memory before) {
        uint256 tokenCount = permit.permitted.length;
        before = new uint256[](tokenCount);
        ISignatureTransfer.SignatureTransferDetails[] memory details =
            new ISignatureTransfer.SignatureTransferDetails[](tokenCount);
        for (uint256 i; i < tokenCount; ++i) {
            before[i] = IERC20(permit.permitted[i].token).balanceOf(address(this));
            details[i] = ISignatureTransfer.SignatureTransferDetails({
                to: address(this), requestedAmount: owed[i]
            });
        }
        PERMIT2.permitWitnessTransferFrom(permit, details, from, witness, WITNESS_TYPE_STRING, signature);
        for (uint256 i; i < tokenCount; ++i) {
            address token = permit.permitted[i].token;
            uint256 received = IERC20(token).balanceOf(address(this)) - before[i];
            if (received != owed[i]) revert ShortReceipt(token, owed[i], received);
        }
    }

    /// Pays every wallet-holding recipient and verifies recipient balance deltas so a
    /// fee-on-transfer or rebasing token that only taxes outbound transfers reverts.
    function _payAll(bytes32 payrollId, Payout[] calldata payouts) internal {
        for (uint256 i; i < payouts.length; ++i) {
            Payout calldata p = payouts[i];
            uint256 balBefore = IERC20(p.token).balanceOf(p.recipient);
            IERC20(p.token).safeTransfer(p.recipient, p.amount);
            uint256 received = IERC20(p.token).balanceOf(p.recipient) - balBefore;
            if (received != p.amount) revert ShortReceipt(p.token, p.amount, received);
            emit PayrollPayout(payrollId, p.token, p.recipient, p.amount);
        }
    }

    /// Each walletless recipient's share becomes an MFA bearer link whose reclaimer is the
    /// treasury (`from`), refundable only after CLAIM_WINDOW.
    function _depositClaims(bytes32 payrollId, address from, ClaimDeposit[] calldata claims) internal {
        uint40 reclaimableAfter = uint40(block.timestamp) + CLAIM_WINDOW;
        for (uint256 i; i < claims.length; ++i) {
            ClaimDeposit calldata c = claims[i];
            IERC20(c.token).forceApprove(address(VAULT), c.amount);
            uint256 index = VAULT.makeCustomDeposit(
                c.token, 1, c.amount, 0, c.linkPubKey20, from, true, address(0), reclaimableAfter, false, ""
            );
            emit PayrollClaimDeposited(payrollId, c.token, c.linkPubKey20, c.amount, index, reclaimableAfter);
        }
    }

    /// No net retention. (Not "balance == 0": a 1-unit donation would then block every
    /// payroll in that token forever.)
    function _assertNoRetention(
        ISignatureTransfer.PermitBatchTransferFrom calldata permit,
        uint256[] memory before
    ) internal view {
        for (uint256 i; i < permit.permitted.length; ++i) {
            address token = permit.permitted[i].token;
            if (IERC20(token).balanceOf(address(this)) != before[i]) revert Retained(token);
        }
    }

    /// Validates every line and returns, per permitted token, the amount owed. Each permitted
    /// token must be unique and its permitted amount must equal exactly what its lines owe.
    function _owedPerToken(
        ISignatureTransfer.PermitBatchTransferFrom calldata permit,
        Payout[] calldata payouts,
        ClaimDeposit[] calldata claims
    ) internal view returns (uint256[] memory owed) {
        uint256 tokenCount = permit.permitted.length;
        for (uint256 i; i < tokenCount; ++i) {
            for (uint256 j; j < i; ++j) {
                if (permit.permitted[i].token == permit.permitted[j].token) {
                    revert DuplicateToken(permit.permitted[i].token);
                }
            }
        }

        owed = new uint256[](tokenCount);
        for (uint256 i; i < payouts.length; ++i) {
            Payout calldata p = payouts[i];
            if (p.amount == 0) revert ZeroAmount();
            if (p.recipient == address(0) || p.recipient == address(this) || p.recipient == address(VAULT)) {
                revert BadRecipient(p.recipient);
            }
            owed[_indexOf(permit, p.token)] += p.amount;
        }
        for (uint256 i; i < claims.length; ++i) {
            ClaimDeposit calldata c = claims[i];
            if (c.amount == 0) revert ZeroAmount();
            // Upstream finding F-2: a zero link key needs no link signature to claim.
            if (c.linkPubKey20 == address(0)) revert ZeroLinkKey();
            owed[_indexOf(permit, c.token)] += c.amount;
        }
        for (uint256 i; i < tokenCount; ++i) {
            if (permit.permitted[i].amount != owed[i]) {
                revert PermittedAmountMismatch(permit.permitted[i].token, permit.permitted[i].amount, owed[i]);
            }
        }
    }

    function _indexOf(ISignatureTransfer.PermitBatchTransferFrom calldata permit, address token)
        internal
        pure
        returns (uint256)
    {
        for (uint256 i; i < permit.permitted.length; ++i) {
            if (permit.permitted[i].token == token) return i;
        }
        revert UnknownToken(token);
    }
}
